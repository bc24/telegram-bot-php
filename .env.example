# Kopieren nach .env und ausfüllen. Die .env niemals committen!

# Token von @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyZ

# Öffentliche HTTPS-Adresse von bot.php
WEBHOOK_URL=https://example.com/telegram-bot/bot.php

# Beliebige zufällige Zeichenkette (A-Z, a-z, 0-9, _ und -), z. B.: openssl rand -hex 32
WEBHOOK_SECRET=bitte-aendern

# Ziel für geplante Nachrichten (Chat-ID, -100… für Gruppen/Kanäle oder @kanalname)
CHAT_ID=@meinkanal

# Ruhezeit für geplante Nachrichten
RUHEZEIT_VON=22:00
RUHEZEIT_BIS=07:00

TIMEZONE=Europe/Berlin
